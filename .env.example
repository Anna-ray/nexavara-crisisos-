# NEXAVARA Crisis Operating System Configuration
# Copy this file to .env and fill in your API keys

# Deployment Environment
ENVIRONMENT=development
DEBUG=true

# AI/ML API Configuration
# Get your AI/ML API key from https://aimlapi.com
AI_ML_API_KEY=your_aiml_api_key_here
AI_ML_ENDPOINT=https://api.aimlapi.com/v1/chat/completions
AI_ML_MODEL=gpt-4o-mini
AI_ML_TIMEOUT=30

# Featherless API Configuration
# Get your Featherless API key from https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_ENDPOINT=https://api.featherless.ai/v1/chat/completions
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_TIMEOUT=30

# Crisis Coordinator Configuration
MAX_RETRIES=2
COORDINATOR_TIMEOUT=30
ENABLE_AUDIT_TRAIL=true

# Database Configuration
DB_ENABLED=false
DB_URL=sqlite:///nexavara_audit.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=nexavara.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# Crisis Response Configuration
INCIDENT_ESCALATION_THRESHOLD=7.0
AUTO_ESCALATE_ON_CRITICAL=true

# Security Configuration
ENABLE_ENCRYPTION=true
ENCRYPTION_KEY=your_encryption_key_here
